{
  "name": "xsai-codex",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@12.3.4",
  "description": "OpenAI Codex provider for xsAI.",
  "author": "Moeru AI",
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/xsai-codex",
  "repository": "github:moeru-ai/xsai-codex",
  "bugs": "https://github.com/moeru-ai/xsai-codex/issues",
  "keywords": [
    "xsai",
    "openai",
    "codex"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pkgroll",
    "bump": "bumpp --no-push",
    "dev": "tsx scripts/example.ts",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "@xsai/text": "^1.0.0-beta.3",
    "@xsai/text-responses": "^1.0.0-beta.3"
  },
  "dependencies": {
    "@xsai/shared": "^1.0.0-beta.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@clack/prompts": "^1.8.1",
    "@moeru/eslint-config": "0.1.0-beta.18",
    "@moeru/std": "0.1.0-beta.20",
    "@moeru/tsconfig": "0.1.0-beta.18",
    "@types/node": "^26.6.5",
    "@xsai/text": "^1.0.0-beta.3",
    "@xsai/text-responses": "^1.0.0-beta.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "pkgroll": "^2.28.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
